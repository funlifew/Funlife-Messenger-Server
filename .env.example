# Django Core Settings
SECRET_KEY=your-secure-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
TIME_ZONE=UTC

# Database Settings
USE_POSTGRES=False
DB_NAME=funlife
DB_USER=funlifeuser
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@funlifemessenger.com

# OTP Settings
OTP_SECRET=generate-with-pyotp-random-base32
MAX_OTP_REFRESH=3
MAX_AUTH_TRIES=5

# JWT Settings
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Rate Limiting
THROTTLE_RATE_ANON=20/minute
THROTTLE_RATE_USER=60/minute

# Security Settings
SECURE_SSL_REDIRECT=True